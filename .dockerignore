# Only inputs needed to compile and verify this application's synthetic fixtures.
**
!Dockerfile
!.dockerignore
!pom.xml
!mvnw
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/maven-wrapper.properties
!src/
!src/main/
!src/main/java/
!src/main/java/**
!src/main/resources/
!src/main/resources/*.yml
!src/main/resources/db/
!src/main/resources/db/domain/
!src/main/resources/db/domain/*.sql
!src/test/
!src/test/java/
!src/test/java/**
!src/test/resources/
!src/test/resources/**
!tools/
!tools/container/
# Exclusions remain last so newly added private inputs cannot override them.
**/.env*
**/secrets/**
**/private/**
**/*.private.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.crt
**/*.cer
**/.aws/**
**/.kube/**
**/.terraform/**
**/*.tfstate*
**/*.dump
**/*.backup
**/*.sql.gz
**/*.sqlite*
**/*.db
**/*.log
**/*.class
**/*.jar
**/.DS_Store

# Exact reviewed public trust bundle/build verifier; all private-key exclusions remain.
!tools/container/VerifyRdsTrust.java
!tools/container/trust/
!tools/container/trust/rds-global-bundle.pem
!tools/container/trust/rds-global-bundle.sha256
