    {"id": "plans-version", "method": "GET", "path": "/api/v1/plans/{id}/versions/{version}", "example": "/api/v1/plans/4b1f1c2a-7e3d-4e8a-9c21-5d6a7b8c9d01/versions/9e8d7c6b-5a4f-4e3d-8c2b-1a0f9e8d7c6b", "statuses": [200], "reads": [], "readsOptional": [], "callers": ["GatewayController.proxy"]},
    {"id": "plans-name", "method": "POST", "path": "/api/v1/plans/{id}/name", "example": "/api/v1/plans/4b1f1c2a-7e3d-4e8a-9c21-5d6a7b8c9d01/name", "statuses": [200, 201], "reads": [], "readsOptional": [], "requestContentType": "application/json", "callers": ["GatewayController.proxy"]},
    {"id": "plans-activity", "method": "POST", "path": "/api/v1/plans/{id}/activity", "example": "/api/v1/plans/4b1f1c2a-7e3d-4e8a-9c21-5d6a7b8c9d01/activity", "statuses": [200, 201], "reads": [], "readsOptional": [], "requestContentType": "application/json", "callers": ["GatewayController.proxy"]},
