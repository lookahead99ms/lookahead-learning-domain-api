{
  "schema": "gateway-domain-contract/v1",
  "consumer": "lookahead99ms/lookahead-learning-gateway-bff",
  "provider": "lookahead99ms/lookahead-learning-domain-api",
  "upstream": "OAuthSettings.domainApiUpstream (app.oauth.domain-api-upstream); DevServiceOrigins.domain in the lower-cost-dev profile",
  "envelope": "Domain answers JSON {\"data\": ..., \"timestamp\": ...}; the Gateway relays proxied bodies byte for byte and parses only the fields listed under reads/readsOptional",
  "notes": [
    "DLV-968 decision T13. Every entry is a call the Gateway source makes today; DomainContractTest in the Gateway drives each example through the Gateway's own routing and DomainProviderContractTest in Domain checks the provider.",
    "statuses are the success statuses the Gateway accepts or relays; 4xx/5xx answers are relayed or mapped by the Gateway and are not part of this list.",
    "example is one concrete path matching the template; path placeholders use Spring path-variable syntax.",
    "Proxied entries (caller GatewayController.proxy) reach Domain from the browser route /bff<path> (or /content/** unchanged) with the browser's Content-Type, Accept, Idempotency-Key, If-Match and X-LookAhead-Account headers plus the server-held bearer token."
  ],
  "calls": [
    {"id": "auth-me", "method": "GET", "path": "/api/v1/auth/me", "example": "/api/v1/auth/me", "statuses": [200], "reads": [], "readsOptional": [],
     "callers": ["GatewayController.proxy", "GatewayController.login", "LogicalSignInFilter"],
     "note": "login and LogicalSignInFilter use only the status (200 keeps the signed-in session, 401 ends it); the proxy relays the body"},
    {"id": "author-preview-access", "method": "GET", "path": "/api/v1/author/previews/access", "example": "/api/v1/author/previews/access", "statuses": [204], "reads": [], "readsOptional": [],
     "callers": ["AuthorPreviewProxy.fetch"], "note": "exactly 204 authorizes the artifact fetch; 401/403 are relayed, anything else becomes 503"},

    {"id": "cloud-admit", "method": "POST", "path": "/internal/v1/cloud-sign-ins/admit", "example": "/internal/v1/cloud-sign-ins/admit", "statuses": [200],
     "reads": ["data.signInId", "data.challengeToken"], "readsOptional": [], "requestContentType": "application/json", "exampleBody": {},
     "callers": ["GatewaySecurityHandlers.loginSucceeded"], "note": "a non-empty challengeToken redirects to /sign-in/choose; otherwise signInId must be present"},
    {"id": "cloud-logout", "method": "POST", "path": "/internal/v1/cloud-sign-ins/logout", "example": "/internal/v1/cloud-sign-ins/logout", "statuses": [200],
     "reads": [], "readsOptional": [], "requestContentType": "application/json", "exampleBody": {},
     "callers": ["GatewayController.cloudLogout"], "note": "200 or 401 confirm the Domain sign-out; any other status fails the browser sign-out"},
    {"id": "cloud-inventory", "method": "GET", "path": "/internal/v1/cloud-sign-ins/inventory", "example": "/internal/v1/cloud-sign-ins/inventory", "statuses": [200],
     "reads": [], "readsOptional": ["data.reauthenticationRequired"], "callers": ["CloudAccountController.read"], "note": "browser route /api/v1/account/sign-ins"},
    {"id": "cloud-challenge", "method": "GET", "path": "/internal/v1/cloud-sign-ins/challenge", "example": "/internal/v1/cloud-sign-ins/challenge", "statuses": [200],
     "reads": [], "readsOptional": ["data.reauthenticationRequired"], "callers": ["CloudAccountController.read"], "note": "browser route /api/v1/auth/sign-in-challenge"},
    {"id": "cloud-profile-read", "method": "GET", "path": "/internal/v1/cloud-sign-ins/profile", "example": "/internal/v1/cloud-sign-ins/profile", "statuses": [200],
     "reads": [], "readsOptional": ["data.reauthenticationRequired"], "callers": ["CloudAccountController.read"], "note": "browser route /api/v1/account/profile"},
    {"id": "cloud-replace", "method": "POST", "path": "/internal/v1/cloud-sign-ins/replace", "example": "/internal/v1/cloud-sign-ins/replace", "statuses": [200],
     "reads": ["data.accountId"], "readsOptional": [], "requestContentType": "application/json", "exampleBody": {"signInId": "0f6d1c0e-6c3a-4a4e-9d6a-2f8c1b7e5a10"},
     "callers": ["CloudAccountController.mutate"], "note": "browser route /api/v1/auth/sign-in-challenge/replace; an empty accountId becomes 503"},
    {"id": "cloud-cancel", "method": "POST", "path": "/internal/v1/cloud-sign-ins/cancel", "example": "/internal/v1/cloud-sign-ins/cancel", "statuses": [200],
     "reads": [], "readsOptional": [], "requestContentType": "application/json", "exampleBody": {},
     "callers": ["CloudAccountController.mutate"], "note": "browser route /api/v1/auth/sign-in-challenge/cancel; 200 always ends the Gateway session"},
    {"id": "cloud-revoke", "method": "POST", "path": "/internal/v1/cloud-sign-ins/revoke", "example": "/internal/v1/cloud-sign-ins/revoke", "statuses": [200],
     "reads": ["data.reauthenticationRequired"], "readsOptional": [], "requestContentType": "application/json", "exampleBody": {"signInId": "0f6d1c0e-6c3a-4a4e-9d6a-2f8c1b7e5a10"},
     "callers": ["CloudAccountController.mutate"], "note": "browser route /api/v1/account/sign-ins/revoke; true ends the Gateway session"},
    {"id": "cloud-revoke-others", "method": "POST", "path": "/internal/v1/cloud-sign-ins/revoke-others", "example": "/internal/v1/cloud-sign-ins/revoke-others", "statuses": [200],
     "reads": ["data.reauthenticationRequired"], "readsOptional": [], "requestContentType": "application/json", "exampleBody": {},
     "callers": ["CloudAccountController.mutate"], "note": "browser route /api/v1/account/sign-ins/revoke-others"},
    {"id": "cloud-label", "method": "POST", "path": "/internal/v1/cloud-sign-ins/label", "example": "/internal/v1/cloud-sign-ins/label", "statuses": [200],
     "reads": [], "readsOptional": ["data.reauthenticationRequired"], "requestContentType": "application/json", "exampleBody": {"label": "Work laptop"},
     "callers": ["CloudAccountController.mutate"], "note": "browser route /api/v1/account/sign-ins/label"},
    {"id": "cloud-profile-write", "method": "POST", "path": "/internal/v1/cloud-sign-ins/profile", "example": "/internal/v1/cloud-sign-ins/profile", "statuses": [200],
     "reads": [], "readsOptional": ["data.reauthenticationRequired"], "requestContentType": "application/json", "exampleBody": {"displayName": "Learner"},
     "callers": ["CloudAccountController.mutate"], "note": "browser route POST /api/v1/account/profile"},
    {"id": "cloud-password", "method": "POST", "path": "/internal/v1/cloud-sign-ins/password", "example": "/internal/v1/cloud-sign-ins/password", "statuses": [200],
     "reads": ["data.reauthenticationRequired"], "readsOptional": [], "requestContentType": "application/json",
     "exampleBody": {"currentPassword": "synthetic-current-password", "newPassword": "synthetic-replacement-password", "confirmPassword": "synthetic-replacement-password"},
     "callers": ["CloudAccountController.mutate"], "note": "browser route /api/v1/account/password; Domain answers reauthenticationRequired true after a change"},
    {"id": "cloud-preferences", "method": "POST", "path": "/internal/v1/cloud-sign-ins/preferences", "example": "/internal/v1/cloud-sign-ins/preferences", "statuses": [200],
     "reads": [], "readsOptional": ["data.reauthenticationRequired"], "requestContentType": "application/json", "exampleBody": {"theme": "dark"},
     "callers": ["CloudAccountController.mutate"], "note": "browser route /api/v1/account/preferences"},
    {"id": "cloud-links", "method": "POST", "path": "/internal/v1/cloud-sign-ins/links", "example": "/internal/v1/cloud-sign-ins/links", "statuses": [200],
     "reads": [], "readsOptional": ["data.reauthenticationRequired"], "requestContentType": "application/json",
     "exampleBody": {"github": null, "linkedin": null, "x": null, "website": null},
     "callers": ["CloudAccountController.mutate"], "note": "browser route /api/v1/account/links; the body keys are Domain's ProfileLinkPolicy.KINDS"},

    {"id": "account-catalog", "method": "GET", "path": "/api/v1/account-catalog", "example": "/api/v1/account-catalog", "statuses": [200], "reads": [], "readsOptional": [], "callers": ["GatewayController.proxy"]},
    {"id": "support", "method": "POST", "path": "/api/v1/support", "example": "/api/v1/support", "statuses": [202], "reads": [], "readsOptional": [], "requestContentType": "application/json", "callers": ["GatewayController.proxy"]},
    {"id": "plans-list", "method": "GET", "path": "/api/v1/plans", "example": "/api/v1/plans", "statuses": [200], "reads": [], "readsOptional": [], "callers": ["GatewayController.proxy"]},
